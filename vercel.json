{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/key-practice-area/:path*", "destination": "/services/", "permanent": true },
    { "source": "/key-industry-sector/:path*", "destination": "/sectors/", "permanent": true },
    { "source": "/contact/london-office/:path*", "destination": "/contact/", "permanent": true },
    { "source": "/contact/ireland-office/:path*", "destination": "/contact/", "permanent": true }
  ]
}
